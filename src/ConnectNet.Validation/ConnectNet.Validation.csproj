<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Description>protovalidate-compatible message validation for Connect RPC services, driven by buf.validate constraints in .proto files.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ConnectNet.Tests" />
    <InternalsVisibleTo Include="ConnectNet.Cel.Conformance" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.*" />
    <PackageReference Include="Grpc.Tools" Version="2.*" PrivateAssets="All" />
    <Protobuf Include="Proto/buf/validate/validate.proto" GrpcServices="None" AdditionalImportDirs="Proto" />
    <!-- Ship validate.proto so consumers can import it: AdditionalImportDirs="$(PkgConnectNet_Validation)/protos". -->
    <None Include="Proto/**/*.proto" Pack="true" PackagePath="protos" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ConnectNet/ConnectNet.csproj" />
  </ItemGroup>
</Project>
