<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>neguse</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/neguse/connect-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neguse/connect-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>connect;connectrpc;grpc;rpc;protobuf</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
