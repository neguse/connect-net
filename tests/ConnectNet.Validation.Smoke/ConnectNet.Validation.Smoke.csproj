<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Consumes the packed ConnectNet.Validation package (not the project) the way an
    application would: a cross-field CEL rule compiled from its own .proto, validation,
    the interceptor, and decoding of the buf.validate.Violations error detail. See run.sh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SmokePackageVersion Condition="'$(SmokePackageVersion)' == ''">0.0.0-smoke</SmokePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ConnectNet.Validation" Version="$(SmokePackageVersion)" GeneratePathProperty="true" />
    <PackageReference Include="Grpc.Tools" Version="2.*" PrivateAssets="All" />
    <Protobuf Include="smoke.proto" GrpcServices="None" AdditionalImportDirs="$(PkgConnectNet_Validation)/protos" />
  </ItemGroup>
</Project>
